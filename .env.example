# ============================================================
# ZeroFraudE Environment Configuration Template
# Copie este archivo a .env antes de iniciar Docker Compose:
#   cp .env.example .env
# ============================================================

# Database Configuration
POSTGRES_DB=fraud_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_URL=jdbc:postgresql://postgres:5432/fraud_dev

# Security
# Clave HMAC-SHA256 para firma y validación de tokens JWT.
# OBLIGATORIO: Debe tener al menos 32 caracteres (256 bits).
# Generar clave segura con: openssl rand -base64 32
# ADVERTENCIA: Nunca utilice una clave predeterminada en entornos de producción.
JWT_SECRET=

# Service URLs
ML_SERVICE_URL=http://ml-service:8000
VITE_API_URL=http://localhost:8081/api/v1

# Model Version
MODEL_VERSION=3.0.0
