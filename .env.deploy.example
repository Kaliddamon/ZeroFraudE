# ==============================================================================
# ZeroFraudE - Variables de Entorno para Despliegue en Producción (Cloud 0 USD)
# ==============================================================================
# Este archivo sirve como plantilla de referencia para configurar las variables
# de entorno en cada uno de los servicios en la nube (Neon, HF Spaces, Render, Cloudflare Pages).
# NO incluir credenciales reales ni contraseñas de producción en este archivo.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL Serverless (Neon.tech)
# ------------------------------------------------------------------------------
# Neon provee la URL de conexión completa. El backend Spring Boot requiere:
# - DB_URL: Formato JDBC estándar con sslmode=require
# - DB_USER: Usuario asignado por Neon
# - DB_PASSWORD: Password generado por Neon
#
# Ejemplo de configuración para Render (Backend Service Environment Variables):
DB_URL=jdbc:postgresql://ep-example-pool.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=YOUR_NEON_PASSWORD_HERE

# ------------------------------------------------------------------------------
# 2. Servicio de Machine Learning (Hugging Face Spaces - Docker SDK)
# ------------------------------------------------------------------------------
# Parámetros del runtime FastAPI / LightGBM:
# - MODEL_VERSION: Versión de artefactos a cargar desde /artifacts/{MODEL_VERSION}
# - PORT: Puerto expuesto (HF Spaces usa app_port: 8000 definido en README.md)
MODEL_VERSION=3.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 3. Backend API REST (Render Web Service - Spring Boot 3.3.3)
# ------------------------------------------------------------------------------
# Variables a configurar en el panel de Render:
# - ML_SERVICE_URL: URL pública HTTPS del Space de Hugging Face
# - JWT_SECRET: Clave secreta para firmar tokens JWT (mínimo 32 caracteres / 256 bits)
# - JWT_EXPIRATION_MS: Tiempo de expiración del token en milisegundos (ej. 86400000 = 24 horas)
# - PORT: Puerto HTTP (Render asigna automáticamente la variable PORT, por defecto 8081 en contenedor)
ML_SERVICE_URL=https://YOUR_HF_USERNAME-zerofraude-ml.hf.space
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARS_LONG
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8081

# ------------------------------------------------------------------------------
# 4. Frontend Web SPA (Cloudflare Pages - React 19 + Vite)
# ------------------------------------------------------------------------------
# Variables de compilación a configurar en Cloudflare Pages:
# - VITE_API_URL: URL pública HTTPS del backend desplegado en Render (incluyendo prefijo /api/v1)
# - VITE_USE_MOCKS: 'false' para conectar a la API real en producción
VITE_API_URL=https://zerofraude-backend.onrender.com/api/v1
VITE_USE_MOCKS=false

